# ---------------------------------------------------------------------------
# Kigali Heights Residence — local database configuration
# Copy this file to `.env.local` and adjust if your MySQL settings differ.
# `.env.local` is git-ignored. Never expose these values to the browser.
# ---------------------------------------------------------------------------

# MySQL / MariaDB connection (XAMPP defaults: root with an empty password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kigali_heights_residence

# Optional: Session encryption / IP hash salt
AUTH_SECRET=replace-with-a-random-32-byte-hex-string

# Administrator bootstrap (used by npm run admin:create)
# These provide safe placeholders for initial setup
ADMIN_NAME="Residence Administrator"
ADMIN_EMAIL="admin@kigaliheights.com"
ADMIN_PHONE="+250 788 123 456"
ADMIN_PASSWORD="ReplaceWithAStrongPassword123!"

# Optional: the ALU Kigali360 virtual tour is hard-coded in
# components/explore/alu-tour.tsx so it can be replaced in one place.
# No key is required for the public tour.

# Optional: a Spline scene for /explore. Leave unset to keep the designed fallback.
# This value is public (it is sent to the browser); do not put secrets here.
# NEXT_PUBLIC_SPLINE_SCENE_URL=https://prod.spline.design/XXXXXXXXXXXX/scene.splinecode

# ---------------------------------------------------------------------------
# Email (optional). Leave SMTP_HOST empty to run without email: sign-up,
# booking and payment still work, and each skipped message is logged instead.
# ---------------------------------------------------------------------------
# Public address of the site, used for links inside emails (password reset etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

SMTP_HOST=
SMTP_PORT=587
# Set to true for implicit TLS (port 465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Kigali Heights Residence <reservations@example.com>"
# Inbox for new reservation / customer / contact alerts (defaults to EMAIL_FROM)
ADMIN_NOTIFICATION_EMAIL=
# Only set to false for a local test SMTP server with a self-signed certificate
# SMTP_TLS_REJECT_UNAUTHORIZED=false
